# 이 파일을 복사해 .env 로 만들어 채우세요. (.env 는 .gitignore 로 커밋 안 됨)
# ⚠️ 실제 비밀번호·토큰은 절대 코드나 저장소에 넣지 말 것 — 여기(또는 Vercel 환경변수)에만.

# 서버리스(Vercel)용 Postgres 연결 문자열 — Supabase → Connect → Transaction 풀러(포트 6543)
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# (선택) 관리자 API 활성화 토큰. 비워두면 /api/admin/* 비활성. 길고 무작위로.
ADMIN_TOKEN=
